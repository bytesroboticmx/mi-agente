# Configuración del Agente CLI
# Copia este archivo a .env y completa tus valores

# Proveedor LLM: openai | anthropic | ollama
LLM_PROVIDER=openai

# Modelo a usar (ejemplos):
# OpenAI: gpt-4o, gpt-4o-mini, gpt-4-turbo
# Anthropic: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022
# Ollama: llama3.1, codellama, mistral
MODEL_NAME=gpt-4o-mini

# API Key (obligatorio para OpenAI/Anthropic)
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/settings/keys
API_KEY=sk-tu-api-key-aqui

# URL base opcional (para Ollama u otros endpoints compatibles)
# Ollama default: http://localhost:11434/v1
# BASE_URL=http://localhost:11434/v1

# Parámetros de generación
TEMPERATURE=0.7
MAX_TOKENS=4096

# Configuración del agente
SYSTEM_PROMPT=Eres un asistente útil que puede usar herramientas para leer/escribir archivos, ejecutar comandos y buscar información.

# Tema de color: default | dark | light
THEME=default